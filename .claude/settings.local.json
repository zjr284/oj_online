{
  "permissions": {
    "allow": [
      "WebFetch(domain:dbg-course.github.io)",
      "Bash(.venv/bin/pytest -q)",
      "Bash(.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000)",
      "Bash(curl -s -o /dev/null http://127.0.0.1:8000/api/auth/login)",
      "Bash(curl -s http://127.0.0.1:8000/api/problems/)",
