      "Bash(curl -s -b /tmp/oj.jar http://127.0.0.1:8000/api/problems/)",
      "Bash(curl -s -b /tmp/oj.jar http://127.0.0.1:8000/api/problems/sum_2)",
      "Bash(curl -s -b /tmp/oj.jar http://127.0.0.1:8000/api/languages/)",
      "Bash(curl -s http://127.0.0.1:8000/)",
      "Bash(curl -s http://127.0.0.1:8000/api/users/)"
    ]
  }
}
