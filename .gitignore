# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# 虚拟环境
.venv/
venv/

# 环境变量与密钥
.env

# 运行时数据（数据库文件不入库；data/problems/ 下的示例题目需入库）
data/*.db
data/problems/*.json.bak

# AI 模块运行时文件（含加密密钥与 Fernet 密钥，绝不可入库）
data/ai_config.json
data/ai_secret.key

# 日志与临时文件
*.log
.DS_Store

# 可复现的性能测试数据（由 scripts/build_find_range_stress.py 生成）
data/generated/
